# Steam credentials used for startup validation and sync operations.
STEAM_API_KEY=
STEAM_ID64=

# Optional LLM provider keys. Configure at least one for Ask LLM.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides for each provider.
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# SQLite cache file path.
CACHE_DB_PATH=cache.db

# Shared HTTP timeout (seconds) for API clients.
HTTP_TIMEOUT_S=15.0
